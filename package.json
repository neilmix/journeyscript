{
  "name": "journeyscript",
  "version": "0.1.4",
  "description": "Create interactive flow diagrams from markdown",
  "main": "dist/journey-visualizer.js",
  "type": "module",
  "bin": {
    "journeyscript": "./tools/journey-build.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "rollup -c && npm run build:examples",
    "build:examples": "node tools/journey-build.js examples/simple.md && node tools/journey-build.js examples/complex.md && node tools/journey-build.js examples/big.md",
    "dev": "vite",
    "journeyscript": "node tools/journey-build.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "files": [
    "dist/",
    "tools/",
    "src/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "markdown",
    "flowchart",
    "diagram",
    "journey",
    "visualization"
  ],
  "author": "Neil Mix",
  "license": "MIT",
  "homepage": "https://neilmix.github.io/journeyscript/",
  "repository": {
    "type": "git",
    "url": "https://github.com/neilmix/journeyscript.git"
  },
  "bugs": {
    "url": "https://github.com/neilmix/journeyscript/issues"
  },
  "dependencies": {
    "@types/markdown-it": "^14.1.2",
    "chrome-remote-interface": "^0.33.3",
    "dagre": "^0.8.5",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "jsdom": "^23.0.0",
    "rollup": "^4.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
